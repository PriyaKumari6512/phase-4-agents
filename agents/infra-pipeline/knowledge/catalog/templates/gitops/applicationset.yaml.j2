apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: {{ project }}-{{ environment }}
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
    - git:
        repoURL: {{ repo_url }}
        revision: HEAD
        directories:
          - path: gitops/apps/*/{{ environment }}
  template:
    metadata:
      name: '{{ "{{" }}index .path.segments 2{{ "}}" }}-{{ environment }}'
    spec:
      project: default
      sources:
        - repoURL: {{ repo_url }}
          targetRevision: HEAD
          path: gitops/charts/app
          helm:
            valueFiles:
              - '../../apps/{{ "{{" }}index .path.segments 2{{ "}}" }}/{{ environment }}/values.yaml'
        - repoURL: {{ repo_url }}
          targetRevision: HEAD
          path: 'gitops/apps/{{ "{{" }}index .path.segments 2{{ "}}" }}/{{ environment }}'
          directory:
            exclude: values.yaml
      destination:
        name: {{ project }}-{{ environment }}
        namespace: {{ project }}-{{ environment }}
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
