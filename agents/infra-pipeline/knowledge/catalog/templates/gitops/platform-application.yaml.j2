apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ project }}-{{ environment }}-platform
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ repo_url }}
    targetRevision: HEAD
    path: gitops/platform/{{ environment }}
    directory:
      recurse: true
  destination:
    name: {{ project }}-{{ environment }}
    namespace: {{ project }}-{{ environment }}
  syncPolicy:
    syncOptions:
      - CreateNamespace=true
