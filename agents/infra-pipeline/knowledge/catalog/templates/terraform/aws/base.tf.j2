# Generated by PDLC Phase 4 (Infra & Pipeline agent) from the golden-path catalog. Review in the PR.
terraform {
  required_version = ">= 1.10.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.0"
    }
  }
  backend "s3" {
    bucket       = "{{ state_bucket }}"
    key          = "{{ project }}/{{ environment }}/core/terraform.tfstate"
    region       = "{{ region }}"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = local.tags
  }
}

variable "project" {
  type    = string
  default = "{{ project }}"
}

variable "environment" {
  type    = string
  default = "{{ environment }}"
}

variable "region" {
  type    = string
  default = "{{ region }}"
}

variable "owner" {
  type    = string
  default = "{{ owner }}"
}

variable "vpc_cidr" {
  type    = string
  default = "{{ vpc_cidr }}"
}

variable "kubernetes_version" {
  type    = string
  default = "1.33"
}

locals {
  tags = {
    project     = var.project
    environment = var.environment
    owner       = var.owner
    managed-by  = "opentofu-phase4"
  }
}
