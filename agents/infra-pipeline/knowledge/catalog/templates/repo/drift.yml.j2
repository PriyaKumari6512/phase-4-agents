name: drift-detection
# Nightly read-only plan. Opens an issue on drift; never applies.
on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch: {}
permissions:
  contents: read
  id-token: write
  issues: write
jobs:
  plan:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        env: [{{ environments | join(", ") }}]
    steps:
      - uses: {{ actions.checkout }}
      - uses: {{ actions.setup_opentofu }}
        with:
          tofu_version: "{{ tofu_version }}"
      - uses: {{ actions.aws_credentials }}
        with:
          role-to-assume: ${{ "{{" }} vars.PLAN_ROLE_ARN {{ "}}" }}
          aws-region: {{ region }}
      - name: Plan (read-only)
        id: plan
        working-directory: envs/${{ "{{" }} matrix.env {{ "}}" }}/core
        run: |
          tofu init -input=false
          set +e
          tofu plan -input=false -lock=false -detailed-exitcode -no-color > plan.txt
          echo "exitcode=$?" >> "$GITHUB_OUTPUT"
      - name: Open drift issue
        if: steps.plan.outputs.exitcode == '2'
        env:
          GH_TOKEN: ${{ "{{" }} github.token {{ "}}" }}
        run: gh issue create --title "Drift detected in ${{ "{{" }} matrix.env {{ "}}" }}" --body "A read-only plan found changes not in Git. Investigate; do not auto-apply." --label drift
