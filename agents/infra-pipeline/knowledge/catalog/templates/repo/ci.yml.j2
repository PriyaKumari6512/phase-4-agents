name: ci
# Generated by PDLC Phase 4 for {{ component }} ({{ runtime }}).
on:
  pull_request: {}
  push:
    branches: [main]
permissions:
  contents: read
  id-token: write
jobs:
{%- if reusable_workflow %}
  build:
    uses: {{ reusable_workflow }}
    with:
      component: {{ component }}
      runtime: {{ runtime }}
    secrets: inherit
{%- else %}
  build-test:
    runs-on: ubuntu-latest
    steps:
      - uses: {{ actions.checkout }}
{%- if runtime_lang == "python" %}
      - uses: {{ actions.setup_python }}
        with:
          python-version: "{{ runtime_version or '3.12' }}"
      - run: pip install -e ".[dev]" || pip install -r requirements.txt
      - run: pytest -q
{%- elif runtime_lang == "node" %}
      - uses: {{ actions.setup_node }}
        with:
          node-version: "{{ runtime_version or '22' }}"
      - run: npm ci
      - run: npm test --if-present
{%- elif runtime_lang == "java" %}
      - uses: {{ actions.setup_java }}
        with:
          distribution: temurin
          java-version: "{{ runtime_version or '21' }}"
      - run: ./mvnw -B verify || mvn -B verify
{%- else %}
      - run: echo "No standard build for runtime {{ runtime }}; add build steps" && exit 1
{%- endif %}
  image:
    needs: build-test
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - uses: {{ actions.checkout }}
      - uses: {{ actions.aws_credentials }}
        with:
          role-to-assume: ${{ "{{" }} vars.CI_ROLE_ARN {{ "}}" }}
          aws-region: {{ region }}
      - name: Build and push image
        run: |
          aws ecr get-login-password | docker login --username AWS --password-stdin "${{ "{{" }} vars.ECR_REGISTRY {{ "}}" }}"
          docker build -t "${{ "{{" }} vars.ECR_REGISTRY {{ "}}" }}/{{ project }}/{{ component }}:${{ "{{" }} github.sha {{ "}}" }}" .
          docker push "${{ "{{" }} vars.ECR_REGISTRY {{ "}}" }}/{{ project }}/{{ component }}:${{ "{{" }} github.sha {{ "}}" }}"
      - name: Record immutable build metadata
        env:
          IMAGE_REPO: ${{ "{{" }} vars.ECR_REGISTRY {{ "}}" }}/{{ project }}/{{ component }}
          BUILD_SHA: ${{ "{{" }} github.sha {{ "}}" }}
        run: |
          digest=$(aws ecr describe-images --repository-name "{{ project }}/{{ component }}" --image-ids imageTag="$BUILD_SHA" --query 'imageDetails[0].imageDigest' --output text)
          python -c 'import json,os,sys; json.dump({"component":"{{ component }}","digest":sys.argv[1],"sha":os.environ["BUILD_SHA"]},open("image.json","w"))' "$digest"
      - uses: actions/upload-artifact@v4
        with:
          name: image-{{ component }}
          path: image.json
{%- endif %}
