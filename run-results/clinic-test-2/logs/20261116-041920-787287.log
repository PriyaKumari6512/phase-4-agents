# Generated by PDLC Phase 4 (Infra & Pipeline agent) from the golden-path catalog. Review in the PR.
terraform {
  required_version = ">= 1.10.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.0"
    }
  }
  backend "s3" {
    bucket       = "clinic-test-2-tfstate"
    key          = "clinic-test-2/prod/core/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = local.tags
  }
}

variable "project" {
  type    = string
  default = "clinic-test-2"
}

variable "environment" {
  type    = string
  default = "prod"
}

variable "region" {
  type    = string
  default = "us-east-1"
}

variable "owner" {
  type    = string
  default = "TaskFlow"
}

variable "vpc_cidr" {
  type    = string
  default = "10.30.0.0/16"
}

variable "kubernetes_version" {
  type    = string
  default = "1.33"
}

locals {
  tags = {
    project     = var.project
    environment = var.environment
    owner       = var.owner
    managed-by  = "opentofu-phase4"
  }
}

data "aws_availability_zones" "available" {
  state = "available"
}

module "network" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "6.7.3"

  name             = "${var.project}-${var.environment}"
  cidr             = var.vpc_cidr
  azs              = slice(data.aws_availability_zones.available.names, 0, 3)
  private_subnets  = [for i in range(3) : cidrsubnet(var.vpc_cidr, 4, i)]
  public_subnets   = [for i in range(3) : cidrsubnet(var.vpc_cidr, 8, 48 + i)]
  database_subnets = [for i in range(3) : cidrsubnet(var.vpc_cidr, 8, 56 + i)]

  create_database_subnet_group = true
  enable_nat_gateway           = true
  single_nat_gateway           = var.environment != "prod"
  enable_dns_hostnames         = true
}

output "vpc_id" {
  value = module.network.vpc_id
}

module "eks" {
  source  = "terraform-aws-modules/eks/aws"
  version = "~> 21.0"

  name               = "${var.project}-${var.environment}"
  kubernetes_version = var.kubernetes_version
  vpc_id             = module.network.vpc_id
  subnet_ids         = module.network.private_subnets

  endpoint_public_access                   = false
  enable_irsa                              = true
  enable_cluster_creator_admin_permissions = true

  eks_managed_node_groups = {
    default = {
      instance_types = ["t3.large"]
      min_size       = 2
      max_size       = 4
      desired_size   = 2
    }
  }
}

output "cluster_name" {
  value = module.eks.cluster_name
}

resource "aws_security_group" "db_taskflow_db" {
  name_prefix = "${var.project}-${var.environment}-taskflow-db-db-"
  description = "Postgres access for taskflow-db from private subnets only"
  vpc_id      = module.network.vpc_id

  ingress {
    description = "Postgres from private subnets"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = module.network.private_subnets_cidr_blocks
  }
}

module "db_taskflow_db" {
  source  = "terraform-aws-modules/rds/aws"
  version = "~> 6.0"

  identifier           = "${var.project}-${var.environment}-taskflow-db"
  engine               = "postgres"
  engine_version       = "16"
  family               = "postgres16"
  major_engine_version = "16"
  instance_class       = "db.t4g.small"

  allocated_storage     = 20
  max_allocated_storage = 200
  storage_encrypted     = true

  db_name  = "taskflow_db"
  username = "app"
  # Master password is created and rotated in AWS Secrets Manager; never written to code or outputs.
  manage_master_user_password = true

  db_subnet_group_name   = module.network.database_subnet_group_name
  vpc_security_group_ids = [aws_security_group.db_taskflow_db.id]

  multi_az                = var.environment == "prod"
  deletion_protection     = true
  backup_retention_period = var.environment == "prod" ? 14 : 3
  skip_final_snapshot     = var.environment != "prod"
}

module "cache_taskflow_cache" {
  source  = "terraform-aws-modules/elasticache/aws"
  version = "~> 1.0"

  replication_group_id = "${var.project}-${var.environment}-taskflow-cache"
  engine               = "redis"
  engine_version       = "7.1"
  node_type            = "cache.t4g.small"
  num_cache_clusters   = var.environment == "prod" ? 2 : 1

  transit_encryption_enabled = true
  at_rest_encryption_enabled = true

  vpc_id              = module.network.vpc_id
  subnet_ids          = module.network.private_subnets
  create_subnet_group = true
  security_group_rules = {
    ingress_vpc = {
      description = "Redis from the VPC"
      cidr_ipv4   = module.network.vpc_cidr_block
    }
  }
}
