# Model provider: set ONE (checked in this order). Same names as agent-harness,
# so its .env can be copied here as-is.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Claude.ai subscription auth instead of an API key.
# SDLC_AGENT_ANTHROPIC_AUTH_MODE=subscription
# SDLC_AGENT_ANTHROPIC_OAUTH_TOKEN=

# Optional: pin the two model tiers (provider:model).
# SDLC_AGENT_STRONG_MODEL=anthropic:claude-sonnet-5-5
# SDLC_AGENT_FAST_MODEL=anthropic:claude-haiku-4-5-20251001

# Optional: Langfuse tracing (every model call, agent and verifier).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Optional: where things live (defaults: <repo>/agents, <repo>/outputs, <repo>/logs).
# AGENT_ENGINE_AGENTS_DIR=
# AGENT_ENGINE_OUTPUTS_DIR=
# AGENT_ENGINE_LOGS_DIR=

# Optional: PDLC Phase 4 agents (docs/PHASE4.md).
# PHASE4_ALLOCATION_SOLVER_URL=http://localhost:8080
# PHASE4_ALLOCATION_SOLVER_MODE=auto     # auto (Timefold if reachable, else local CP-SAT) | timefold | local
# PHASE4_IAC_SANDBOX_IMAGE=phase4/iac-sandbox:dev
# PHASE4_IAC_SANDBOX_MODE=auto           # auto (docker image, else local tools) | off
# PHASE4_IAC_TOTAL_BUDGET_SECONDS=900    # total command budget per validation call, 1..7200
# PHASE4_IAC_CACHE_DIR=                  # downloaded providers/modules; never published
# PHASE4_KUBERNETES_SCHEMA_LOCATION=    # trusted additional kubeconform schema location for CRDs
# PHASE4_PR_MODE=local                   # local (files under outputs/<project>/publish/prs) | github
# Tracker / GitHub credentials, only for what phase4/project.json uses:
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# LINEAR_API_KEY=
# GITHUB_TOKEN=
# GITHUB_COPILOT_USER_TOKEN=

# Complete pipeline, one entry point: uv run agent-engine pipeline
# Defaults on this entry point: publishing, independent stage overlap, diagnostics,
# and two concurrent IaC scanners. Existing CLI commands retain their defaults.
# PHASE4_PROJECT_NAME=clinic-test-2       # existing folder under outputs/; not the display name
# PHASE4_TRACKER=jira                    # explicitly selects Jira instead of the project.json default
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_PROJECT_KEY=YOURPROJECT
# JIRA_BOARD_ID=123                      # Scrum board, required for sprint publication
# PHASE4_AUTO_APPROVE_FOR_TESTING=true   # real publication after passing checks; NOT a human sign-off
# AGENT_ENGINE_PERF_MODE=publication     # required if your existing .env sets generation mode
# Optional Jira overrides; defaults shown. No additional CLI flags needed.
# JIRA_PUBLISH_CONCURRENCY=4             # 1..16 independent workers; parents still precede children
# JIRA_MIN_WRITE_INTERVAL_SECONDS=0.25   # shared request-start spacing; respects server rate limits
# JIRA_TIMEOUT_SECONDS=30
# JIRA_MAX_RETRIES=5
# JIRA_ACCOUNT_MAP='{"existing-member-id":"actual-jira-account-id"}'
# JIRA_ISSUE_TYPE_IDS='{"epic":"10000","story":"10001","task":"10002"}' # task must be a subtask type
# JIRA_CREATE_FIELDS='{"story":{"customfield_12345":{"id":"required-option-id"}}}'
# JIRA_STORY_POINTS_FIELD_ID=customfield_10016 # only if board estimation doesn't expose the right field
# PHASE4_SPRINT_INDEX=1
# PHASE4_PUBLISH=true
# PHASE4_PARALLEL_STAGES=true
# PHASE4_RESUME=false                    # true = reuse saved recovery state; default: every run starts fresh
# AGENT_ENGINE_PROVIDER_RETRIES=3        # stage reruns after a rate limit / transient provider error
# AGENT_ENGINE_RATE_LIMIT_MAX_WAIT_SECONDS=1800  # longest wait for a rate-limit reset; longer stops with the reason
# AGENT_ENGINE_TRANSIENT_BACKOFF_SECONDS=60      # first backoff after a transient error (doubles per retry)
# Full setup, behavior and recovery: docs/PIPELINE_JIRA.md; failure handling: docs/PIPELINE_RELIABILITY.md.

# Performance diagnostics: enabled by `pipeline`; other commands require AGENT_ENGINE_PERF=1.
# AGENT_ENGINE_PERF=1
# AGENT_ENGINE_PERF_SESSION=my-benchmark-case
# AGENT_ENGINE_PERF_DIR=                  # default <logs>/perf; must not overlap outputs/ or agents/
# AGENT_ENGINE_PERF_MODE=generation       # generation (publishing refused) | publication
# AGENT_ENGINE_PERF_SAMPLE_SECONDS=5
# AGENT_ENGINE_PERF_RAW_OUTPUT=1

# Per graph pass (writer, verifier, or repair); commands have their own deadlines.
# AGENT_ENGINE_PASS_TIMEOUT_SECONDS=1800
# AGENT_ENGINE_HELPER_CONCURRENCY=9
# AGENT_ENGINE_TRANSCRIPT_MAX_CHARS=20000

# Opt-in isolated scanner overlap, 1..4. Start at 2 only when RAM/disk permit.
# PHASE4_IAC_CHECK_CONCURRENCY=1
# Owned validation workspaces only: soft limits, applied before validation under a lease.
# Active workspace is retained; provider binaries / Docker volumes are not covered by these limits.
# PHASE4_IAC_CACHE_TTL_DAYS=14
# PHASE4_IAC_CACHE_MAX_BYTES=2147483648
# See docs/PERFORMANCE_CONTROLS.md for stage overlap, verification retry and measurement.

# Task Breakdown only: one shared budget across story calls, the cross-story pass, review and repairs.
# Defaults apply automatically. Token limits use reported usage and may overshoot with in-flight calls.
# AGENT_ENGINE_BREAKDOWN_MAX_CALLS=1000
# AGENT_ENGINE_BREAKDOWN_MAX_INPUT_TOKENS=30000000
# AGENT_ENGINE_BREAKDOWN_MAX_OUTPUT_TOKENS=2000000
# AGENT_ENGINE_BREAKDOWN_TIMEOUT_SECONDS=7200
# Bigger model a failed check escalates to (default anthropic:claude-opus-5-5 for Anthropic models):
# SDLC_AGENT_FRONTIER_MODEL=
# Approved stories from Jira (read-only) and how publishing treats them:
# JIRA_STORY_JQL=project = "KEY" AND issuetype = Story AND statusCategory = "To Do" ORDER BY key ASC
# PHASE4_STORY_APPROVAL_MARKER=Approved at gate G2
# JIRA_ACCEPTANCE_FIELD_ID=
# PHASE4_WRITE_STORY_POINTS=never
# See docs/TASK_BREAKDOWN.md. Budget exhaustion preserves partial results and requires review.
