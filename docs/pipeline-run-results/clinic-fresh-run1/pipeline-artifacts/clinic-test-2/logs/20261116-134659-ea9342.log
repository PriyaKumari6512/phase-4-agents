  14904:           "req_id": "FR-005",
  14917:       "description_md": "Write tests in `clinic-api/tests/identity/test_erasure.py`: request recorded with date, sign-in blocked, person rows and account anonymised together, ports called for appointments and messages, a failing port leaves the request pending and the daily retry completes it, non-manager refused, future-appointment count shown in the preview, and the stored columns of the four tables are exactly those in data-model.md (no clinical data, FR-021)",
  14976:           "req_id": "NFR-007",
  14981:           "req_id": "FR-004",
  15052:           "req_id": "NFR-007",
