        },
        {
          "ac_id": "AC-S-001-US1-5",
          "format": "gherkin",
          "text": "Given a database change in a release, When the pipeline deploys it, Then the change only adds or relaxes structures (expand) and stays compatible with the previous release; removals happen in a later release (contract)"
        }
      ],
