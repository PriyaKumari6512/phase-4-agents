System_Ext(act_whatsapp_provider, "WhatsApp provider", "Approved templates")
Rel(act_patient, ctr_web, "rel-001 Books, changes", "HTTPS")
Rel(act_receptionist, ctr_web, "rel-002 Runs the day", "HTTPS")
Rel(act_dentist, ctr_web, "rel-003 Views own day", "HTTPS")
Rel(act_practice_manager, ctr_web, "rel-004 Sets up, reports", "HTTPS")
